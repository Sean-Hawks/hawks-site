DISCORD_BOT_TOKEN=
# Your Discord user ID (right-click your profile with Developer Mode enabled).
DISCORD_OWNER_IDS=
# Optional: register commands instantly in one server, otherwise globally.
DISCORD_GUILD_ID=
# GitHub fine-grained token: Contents read/write for hawks-site only.
GITHUB_TOKEN=
GITHUB_REPOSITORY=Sean-Hawks/hawks-site
GITHUB_BRANCH=main
SITE_URL=https://hawks.tw
# Must be private, persistent storage. Back up this directory.
AGENT_DATA_DIR=.data

# Set automatically by npm run setup:channel. Requires Message Content Intent.
DISCORD_BLOG_CHANNEL_ID=

# Actions read permission is required to track publishing.
GITHUB_DEPLOY_WORKFLOW=deploy.yml

# Optional Gemini editor. Only invoked by explicit Discord buttons.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
