{
  "name": "hawks-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/bot.mjs",
    "register": "node --env-file-if-exists=.env src/register.mjs",
    "test": "node --test",
    "service:install": "node src/service.mjs",
    "service:stop": "node src/service.mjs --stop",
    "background:start": "node src/background.mjs start",
    "background:stop": "node src/background.mjs stop",
    "background:status": "node src/background.mjs status",
    "setup:channel": "node --env-file=.env src/setup-channel.mjs"
  },
  "dependencies": {
    "diff": "^9.0.0",
    "discord.js": "^14.22.1",
    "gray-matter": "^4.0.3",
    "marked": "^18.0.12",
    "sanitize-html": "^2.17.7",
    "sharp": "^0.35.4"
  }
}
