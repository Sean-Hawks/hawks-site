{
  "name": "hawks-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "now": "node scripts/new-now.mjs",
    "og": "node scripts/generate-og-images.mjs",
    "prebuild": "node scripts/generate-og-images.mjs",
    "build": "next build",
    "postbuild": "node scripts/create-pages-fallbacks.mjs && node scripts/preserve-static-assets.mjs",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "check:export": "python3 scripts/check-export.py",
    "test:export": "python3 -m unittest discover -s tests -p test_export.py"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.475.0",
    "next": "15.5.25",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.1",
    "rehype-react": "^8.0.0",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-rehype": "^11.1.2",
    "sharp": "^0.35.4",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.28"
    }
  },
  "engines": {
    "node": ">=22.12"
  }
}
