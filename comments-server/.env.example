COMMENTS_HOST=127.0.0.1
COMMENTS_PORT=8790
COMMENTS_DATA_DIR=.data
COMMENTS_ORIGINS=https://hawks.tw,http://localhost:3000,http://127.0.0.1:3000
# Only set cloudflare when traffic reaches this service through Cloudflare Tunnel.
# For native Tailscale Serve/Funnel on the same host, set tailscale.
COMMENTS_PROXY=none
# Production requires Turnstile; the site key belongs in the website build env.
COMMENTS_TURNSTILE_SECRET=
COMMENTS_TURNSTILE_HOSTNAMES=hawks.tw
# Explicit opt-in for LOCAL development only; keep false on public deployments.
COMMENTS_ALLOW_UNVERIFIED=false
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
COMMENTS_ADMIN_TOKEN=
